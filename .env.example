# Copy to .env and fill in, or just export these before running.
#
# TWO different `pwhsec_…` secrets live here and they are NOT interchangeable:
#
#   WEBSUITE_WEBHOOK_SECRET  verifies events Pylot sends OUT to this receiver
#   PYLOT_SIGNING_SECRET     authenticates messages this box sends IN to Pylot
#
# Both HMAC the same way. Neither verifies the other. Swapping them produces an
# unexplained 403 (sending) or a digest mismatch (receiving).

# ─────────────────────────────────────────────────────────── receiving (index.js)

# The subscription signing secret, returned ONCE by "Create subscription".
# Without it the receiver still prints payloads but cannot verify them.
WEBSUITE_WEBHOOK_SECRET=pwhsec_...

# Free token from https://dashboard.ngrok.com/get-started/your-authtoken
# Without it the receiver runs local-only (no public URL).
NGROK_AUTHTOKEN=

# Optional: a reserved ngrok domain, so the public URL survives restarts and you
# don't have to update the subscription every time.
NGROK_DOMAIN=

# Optional overrides.
PORT=2000
WEBHOOK_PATH=/webhook
TOLERANCE_SECONDS=300

# Reply 401 instead of 200 when a signature fails, to exercise the retry
# schedule (1/3/10/30/60s, cap 5). Default is to ack everything so you always
# see the payload.
REJECT_INVALID=

# Skip ngrok entirely.
NO_TUNNEL=

# ─────────────────────────────────────────── sending (send.js + the send panel)

# Where the platform lives. `/api/v2` is part of it — the endpoint is
# POST /api/v2/rooms/messages. Use http://localhost:4000/api/v2 against a local
# backend. Overridable per-send: the API base field in the UI, or `--api`.
PYLOT_API_URL=https://api.websuite.ar/api/v2

# The TEAM SIGNING KEY — what lets an external system POST /rooms/messages with
# no api key and no token. Get it from `GET /rooms/signing-key`, or run
# `node send.js --provision` (which needs PYLOT_TOKEN, once).
# Treat it like a password: it can send as the team, to any of its rooms.
#
# Optional: leave it blank and paste the key into the Send or Signature tab
# instead (or pass `--key` to send.js). Both override this value when set, and
# neither writes anything back here — handy when you are testing more than one
# team or environment.
PYLOT_SIGNING_SECRET=

# Default send target.
PYLOT_ROOM_ID=

# Default channel, for "connect + send" (open a room and send in one call).
PYLOT_USER_CONNECTION_ID=

# A JWT. Only used by `--provision` (to fetch the signing key) and `--unsigned`
# (to compare the two auth models). The signed path needs no token at all.
PYLOT_TOKEN=

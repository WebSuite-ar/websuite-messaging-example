# Copy to .env and fill in, or just export these before running.

# The subscription signing secret, returned ONCE by "Create subscription".
# Without it the receiver still prints payloads but cannot verify them.
WEBSUITE_WEBHOOK_SECRET=pwhsec_...

# Free token from https://dashboard.ngrok.com/get-started/your-authtoken
# Without it the receiver runs local-only (no public URL).
NGROK_AUTHTOKEN=

# Optional: a reserved ngrok domain, so the public URL survives restarts and you
# don't have to update the subscription every time.
NGROK_DOMAIN=

# Optional overrides.
PORT=2000
WEBHOOK_PATH=/webhook
TOLERANCE_SECONDS=300

# Reply 401 instead of 200 when a signature fails, to exercise the retry
# schedule (1/3/10/30/60s, cap 5). Default is to ack everything so you always
# see the payload.
REJECT_INVALID=

# Skip ngrok entirely.
NO_TUNNEL=
